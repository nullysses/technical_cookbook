<div id="<%= dom_id step %>">
  <div>
    <strong>Recipe:</strong>
    <%= step.recipe_id %>
  </div>

  <div>
    <strong>Order:</strong>
    <%= step.order %>
  </div>

  <div>
    <strong>Title:</strong>
    <%= step.title %>
  </div>

  <div>
    <strong>Action:</strong>
    <%= step.action %>
  </div>

  <div>
    <strong>Time amount:</strong>
    <%= step.time_amount %>
  </div>

  <div>
    <strong>Time unit:</strong>
    <%= step.time_unit %>
  </div>

  <div>
    <strong>Time per side:</strong>
    <%= step.time_per_side %>
  </div>

  <div>
    <strong>Time description:</strong>
    <%= step.time_description %>
  </div>

  <div>
    <strong>Temperature amount:</strong>
    <%= step.temperature_amount %>
  </div>

  <div>
    <strong>Temperature unit:</strong>
    <%= step.temperature_unit %>
  </div>

  <div>
    <strong>Temperature description:</strong>
    <%= step.temperature_description %>
  </div>

  <div>
    <strong>Heat level:</strong>
    <%= step.heat_level %>
  </div>

  <div>
    <strong>Targets:</strong>
    <%= step.targets %>
  </div>

  <div>
    <strong>Risk points:</strong>
    <%= step.risk_points %>
  </div>

  <div>
    <strong>Notes:</strong>
    <%= step.notes %>
  </div>

  <div>
    <strong>Optional data:</strong>
    <%= step.optional_data %>
  </div>

</div>
