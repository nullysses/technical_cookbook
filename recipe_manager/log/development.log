  ↳ app/services/nested_recipe_importer.rb:49:in 'block in NestedRecipeImporter#create_ingredients'
  [1m[36mStep Create (0.1ms)[0m  [1m[32mINSERT INTO "steps" ("recipe_id", "order", "title", "action", "time_amount", "time_unit", "time_per_side", "time_description", "temperature_amount", "temperature_unit", "temperature_description", "heat_level", "targets", "risk_points", "notes", "optional_data", "created_at", "updated_at") VALUES (4, 1, 'Cook the rice', 'Rinse the rice until the water runs mostly clear, then cook using your normal stovetop or rice-cooker method.', '20', 'min', NULL, 'approximate, depending on rice type', NULL, NULL, NULL, NULL, 'grains cooked through; not mushy; ready before the seitan is sauced', '', 'Start the rice first so the teriyaki seitan can be served immediately after saucing.', NULL, '2026-05-02 00:37:50.210830', '2026-05-02 00:37:50.210830') RETURNING "id" /*action='create',application='RecipeManager',controller='recipe_imports'*/[0m
  ↳ app/services/nested_recipe_importer.rb:64:in 'block in NestedRecipeImporter#create_steps'
  [1m[36mStep Create (0.1ms)[0m  [1m[32mINSERT INTO "steps" ("recipe_id", "order", "title", "action", "time_amount", "time_unit", "time_per_side", "time_description", "temperature_amount", "temperature_unit", "temperature_description", "heat_level", "targets", "risk_points", "notes", "optional_data", "created_at", "updated_at") VALUES (4, 2, 'Mix the dry seitan ingredients', 'Combine vital wheat gluten, nutritional yeast, garlic salt, and black pepper in a mixing bowl.', NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, 'dry ingredients evenly distributed', 'Uneven seasoning can create salty pockets in the dough.', '', NULL, '2026-05-02 00:37:50.213356', '2026-05-02 00:37:50.213356') RETURNING "id" /*action='create',application='RecipeManager',controller='recipe_imports'*/[0m
  ↳ app/services/nested_recipe_importer.rb:64:in 'block in NestedRecipeImporter#create_steps'
  [1m[36mStep Create (0.1ms)[0m  [1m[32mINSERT INTO "steps" ("recipe_id", "order", "title", "action", "time_amount", "time_unit", "time_per_side", "time_description", "temperature_amount", "temperature_unit", "temperature_description", "heat_level", "targets", "risk_points", "notes", "optional_data", "created_at", "updated_at") VALUES (4, 3, 'Form the seitan dough', 'Add water and soy sauce to the dry ingredients. Mix until a cohesive dough forms, then knead briefly.', '2', 'min', NULL, NULL, NULL, NULL, NULL, NULL, 'cohesive dough; slightly elastic; not batter-like; not excessively tough', 'Too much kneading can make the seitan rubbery.; Too much liquid can make the dough sticky and hard to shape.', 'If the dough is too sticky, add vital wheat gluten 1 tbsp at a time until manageable.', NULL, '2026-05-02 00:37:50.216067', '2026-05-02 00:37:50.216067') RETURNING "id" /*action='create',application='RecipeManager',controller='recipe_imports'*/[0m
  ↳ app/services/nested_recipe_importer.rb:64:in 'block in NestedRecipeImporter#create_steps'
  [1m[36mStep Create (0.1ms)[0m  [1m[32mINSERT INTO "steps" ("recipe_id", "order", "title", "action", "time_amount", "time_unit", "time_per_side", "time_description", "temperature_amount", "temperature_unit", "temperature_description", "heat_level", "targets", "risk_points", "notes", "optional_data", "created_at", "updated_at") VALUES (4, 4, 'Shape the seitan', 'Shape the dough into a compact slab or several thick pieces suitable for steaming.', NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, 'even thickness; compact shape; no loose wet patches', '', '', NULL, '2026-05-02 00:37:50.218679', '2026-05-02 00:37:50.218679') RETURNING "id" /*action='create',application='RecipeManager',controller='recipe_imports'*/[0m
  ↳ app/services/nested_recipe_importer.rb:64:in 'block in NestedRecipeImporter#create_steps'
  [1m[36mStep Create (0.1ms)[0m  [1m[32mINSERT INTO "steps" ("recipe_id", "order", "title", "action", "time_amount", "time_unit", "time_per_side", "time_description", "temperature_amount", "temperature_unit", "temperature_description", "heat_level", "targets", "risk_points", "notes", "optional_data", "created_at", "updated_at") VALUES (4, 5, 'Steam the seitan', 'Steam the shaped seitan until firm and cooked through.', '25', 'min', NULL, NULL, NULL, NULL, 'active steam', NULL, 'firm texture; springy but not wet; sliceable pieces', 'Under-steamed seitan can remain gummy inside.', '', NULL, '2026-05-02 00:37:50.221176', '2026-05-02 00:37:50.221176') RETURNING "id" /*action='create',application='RecipeManager',controller='recipe_imports'*/[0m
  ↳ app/services/nested_recipe_importer.rb:64:in 'block in NestedRecipeImporter#create_steps'
  [1m[36mStep Create (0.1ms)[0m  [1m[32mINSERT INTO "steps" ("recipe_id", "order", "title", "action", "time_amount", "time_unit", "time_per_side", "time_description", "temperature_amount", "temperature_unit", "temperature_description", "heat_level", "targets", "risk_points", "notes", "optional_data", "created_at", "updated_at") VALUES (4, 6, 'Rest and cut', 'Let the steamed seitan rest briefly, then cut or tear it into bite-size pieces.', '5', 'min', NULL, NULL, NULL, NULL, NULL, NULL, 'pieces hold their shape; rough edges available for browning', '', 'Torn edges brown better than perfectly smooth cuts.', NULL, '2026-05-02 00:37:50.223631', '2026-05-02 00:37:50.223631') RETURNING "id" /*action='create',application='RecipeManager',controller='recipe_imports'*/[0m
  ↳ app/services/nested_recipe_importer.rb:64:in 'block in NestedRecipeImporter#create_steps'
  [1m[36mStep Create (0.1ms)[0m  [1m[32mINSERT INTO "steps" ("recipe_id", "order", "title", "action", "time_amount", "time_unit", "time_per_side", "time_description", "temperature_amount", "temperature_unit", "temperature_description", "heat_level", "targets", "risk_points", "notes", "optional_data", "created_at", "updated_at") VALUES (4, 7, 'Mix the teriyaki sauce', 'Combine soy sauce, water, sugar, vinegar, ginger, and garlic. If using cornstarch, mix it separately with 1 tbsp water to form a slurry.', NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, 'sugar dissolved; balanced salty-sweet-acidic sauce; no cornstarch lumps', '', 'Keep the cornstarch slurry separate until the sauce is hot.', NULL, '2026-05-02 00:37:50.226224', '2026-05-02 00:37:50.226224') RETURNING "id" /*action='create',application='RecipeManager',controller='recipe_imports'*/[0m
  ↳ app/services/nested_recipe_importer.rb:64:in 'block in NestedRecipeImporter#create_steps'
  [1m[36mStep Create (0.1ms)[0m  [1m[32mINSERT INTO "steps" ("recipe_id", "order", "title", "action", "time_amount", "time_unit", "time_per_side", "time_description", "temperature_amount", "temperature_unit", "temperature_description", "heat_level", "targets", "risk_points", "notes", "optional_data", "created_at", "updated_at") VALUES (4, 8, 'Sear the seitan', 'Heat neutral oil in a skillet over medium-high heat. Add seitan pieces and brown on multiple sides.', '6', 'min', NULL, NULL, NULL, NULL, NULL, 'medium-high', 'browned edges; light crust; savory toasted aroma', 'Crowding the pan causes steaming instead of browning.; Adding sauce too early prevents crust formation.', '', NULL, '2026-05-02 00:37:50.228684', '2026-05-02 00:37:50.228684') RETURNING "id" /*action='create',application='RecipeManager',controller='recipe_imports'*/[0m
  ↳ app/services/nested_recipe_importer.rb:64:in 'block in NestedRecipeImporter#create_steps'
  [1m[36mStep Create (0.1ms)[0m  [1m[32mINSERT INTO "steps" ("recipe_id", "order", "title", "action", "time_amount", "time_unit", "time_per_side", "time_description", "temperature_amount", "temperature_unit", "temperature_description", "heat_level", "targets", "risk_points", "notes", "optional_data", "created_at", "updated_at") VALUES (4, 9, 'Glaze with sauce', 'Lower heat to medium, add the teriyaki sauce, and toss the seitan until coated. Add cornstarch slurry if using, then simmer briefly until glossy.', '2', 'min', NULL, NULL, NULL, NULL, NULL, 'medium', 'glossy sauce; seitan evenly coated; sauce clings without becoming gluey', 'Reducing too long can make the sauce overly salty.; Too much cornstarch can make the glaze pasty.', '', NULL, '2026-05-02 00:37:50.231349', '2026-05-02 00:37:50.231349') RETURNING "id" /*action='create',application='RecipeManager',controller='recipe_imports'*/[0m
  ↳ app/services/nested_recipe_importer.rb:64:in 'block in NestedRecipeImporter#create_steps'
  [1m[36mStep Create (0.1ms)[0m  [1m[32mINSERT INTO "steps" ("recipe_id", "order", "title", "action", "time_amount", "time_unit", "time_per_side", "time_description", "temperature_amount", "temperature_unit", "temperature_description", "heat_level", "targets", "risk_points", "notes", "optional_data", "created_at", "updated_at") VALUES (4, 10, 'Serve', 'Serve the glazed seitan over rice immediately.', NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, 'hot rice; glossy seitan; balanced salty-sweet sauce', '', '', NULL, '2026-05-02 00:37:50.233993', '2026-05-02 00:37:50.233993') RETURNING "id" /*action='create',application='RecipeManager',controller='recipe_imports'*/[0m
  ↳ app/services/nested_recipe_importer.rb:64:in 'block in NestedRecipeImporter#create_steps'
  [1m[36mTechniqueNote Create (0.1ms)[0m  [1m[32mINSERT INTO "technique_notes" ("recipe_id", "topic", "note", "created_at", "updated_at") VALUES (4, 'seitan texture', 'Vital wheat gluten hydrates quickly and becomes elastic. Knead only enough to form structure; excessive kneading pushes the texture toward rubbery.', '2026-05-02 00:37:50.236570', '2026-05-02 00:37:50.236570') RETURNING "id" /*action='create',application='RecipeManager',controller='recipe_imports'*/[0m
  ↳ app/services/nested_recipe_importer.rb:86:in 'block in NestedRecipeImporter#create_technique_notes'
  [1m[36mTechniqueNote Create (0.1ms)[0m  [1m[32mINSERT INTO "technique_notes" ("recipe_id", "topic", "note", "created_at", "updated_at") VALUES (4, 'steam before sear', 'Steaming sets the gluten network before browning. Searing raw seitan dough directly can leave the interior gummy.', '2026-05-02 00:37:50.238902', '2026-05-02 00:37:50.238902') RETURNING "id" /*action='create',application='RecipeManager',controller='recipe_imports'*/[0m
  ↳ app/services/nested_recipe_importer.rb:86:in 'block in NestedRecipeImporter#create_technique_notes'
  [1m[36mTechniqueNote Create (0.2ms)[0m  [1m[32mINSERT INTO "technique_notes" ("recipe_id", "topic", "note", "created_at", "updated_at") VALUES (4, 'browning', 'The seitan should be relatively dry on the surface before searing. Browning creates the savory base that keeps the final dish from tasting like plain gluten in sauce.', '2026-05-02 00:37:50.241147', '2026-05-02 00:37:50.241147') RETURNING "id" /*action='create',application='RecipeManager',controller='recipe_imports'*/[0m
  ↳ app/services/nested_recipe_importer.rb:86:in 'block in NestedRecipeImporter#create_technique_notes'
  [1m[36mTechniqueNote Create (0.1ms)[0m  [1m[32mINSERT INTO "technique_notes" ("recipe_id", "topic", "note", "created_at", "updated_at") VALUES (4, 'salt control', 'Soy sauce, garlic salt, and reduced sauce can compound quickly. If using garlic salt, reduce soy sauce in the dough or sauce.', '2026-05-02 00:37:50.248222', '2026-05-02 00:37:50.248222') RETURNING "id" /*action='create',application='RecipeManager',controller='recipe_imports'*/[0m
