<%= form_with(model: substitute) do |form| %>
  <% if substitute.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(substitute.errors.count, "error") %> prohibited this substitute from being saved:</h2>

      <ul>
        <% substitute.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :substitution_id, style: "display: block" %>
    <%= form.text_field :substitution_id %>
  </div>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :ratio, style: "display: block" %>
    <%= form.text_field :ratio %>
  </div>

  <div>
    <%= form.label :effect, style: "display: block" %>
    <%= form.textarea :effect %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
