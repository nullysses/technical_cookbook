  ↳ app/services/nested_recipe_importer.rb:28:in 'NestedRecipeImporter#create_recipe'
  [1m[36mRecipe Create (0.1ms)[0m  [1m[32mINSERT INTO "recipes" ("stable_id", "title", "version", "language", "diet", "tags", "equipment", "nutrition_notes", "servings_count", "servings_unit", "yield_amount", "yield_unit", "yield_description", "source_created_from", "source_notes", "created_at", "updated_at") VALUES ('gluten-teriyaki-with-rice', 'Gluten Teriyaki with Rice', '1.0', 'en', 'vegan', 'vegan; seitan; vital wheat gluten; teriyaki; rice; stovetop; high-protein', 'mixing bowl; steamer or steaming setup; skillet; saucepan or rice cooker; measuring cups; spatula', 'High-protein vegan main dish.; Salt level depends heavily on soy sauce and garlic salt.; Serve with rice or vegetables to balance the concentrated gluten and sauce.', 3.0, 'people', NULL, NULL, 'deeply savory seitan pieces in glossy teriyaki-style sauce, served with rice', 'chat', 'Based on the gluten teriyaki dinner using vital wheat gluten, rice, soy sauce, vinegar, sugar, and a salty sauce adjustment.', '2026-05-02 01:47:29.896720', '2026-05-02 01:47:29.896720') RETURNING "id" /*application='RecipeManager'*/[0m
  ↳ app/services/nested_recipe_importer.rb:28:in 'NestedRecipeImporter#create_recipe'
  [1m[36mStep Create (0.1ms)[0m  [1m[32mINSERT INTO "steps" ("recipe_id", "order", "title", "action", "time_amount", "time_unit", "time_per_side", "time_description", "temperature_amount", "temperature_unit", "temperature_description", "heat_level", "targets", "risk_points", "notes", "optional_data", "created_at", "updated_at") VALUES (9, 1, 'Cook the rice', 'Rinse the rice until the water runs mostly clear, then cook using your normal stovetop or rice-cooker method.', '20', 'min', NULL, 'approximate, depending on rice type', NULL, NULL, NULL, NULL, 'grains cooked through; not mushy; ready before the seitan is sauced', '', 'Start the rice first so the teriyaki seitan can be served immediately after saucing.', NULL, '2026-05-02 01:47:29.899006', '2026-05-02 01:47:29.899006') RETURNING "id" /*application='RecipeManager'*/[0m
  ↳ app/services/nested_recipe_importer.rb:67:in 'block in NestedRecipeImporter#create_steps'
  [1m[36mStep Create (0.1ms)[0m  [1m[32mINSERT INTO "steps" ("recipe_id", "order", "title", "action", "time_amount", "time_unit", "time_per_side", "time_description", "temperature_amount", "temperature_unit", "temperature_description", "heat_level", "targets", "risk_points", "notes", "optional_data", "created_at", "updated_at") VALUES (9, 2, 'Mix the dry seitan ingredients', 'Combine vital wheat gluten, nutritional yeast, garlic salt, and black pepper in a mixing bowl.', NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, 'dry ingredients evenly distributed', 'Uneven seasoning can create salty pockets in the dough.', '', NULL, '2026-05-02 01:47:29.901494', '2026-05-02 01:47:29.901494') RETURNING "id" /*application='RecipeManager'*/[0m
  ↳ app/services/nested_recipe_importer.rb:67:in 'block in NestedRecipeImporter#create_steps'
  [1m[36mStep Create (0.1ms)[0m  [1m[32mINSERT INTO "steps" ("recipe_id", "order", "title", "action", "time_amount", "time_unit", "time_per_side", "time_description", "temperature_amount", "temperature_unit", "temperature_description", "heat_level", "targets", "risk_points", "notes", "optional_data", "created_at", "updated_at") VALUES (9, 3, 'Form the seitan dough', 'Add water and soy sauce to the dry ingredients. Mix until a cohesive dough forms, then knead briefly.', '2', 'min', NULL, NULL, NULL, NULL, NULL, NULL, 'cohesive dough; slightly elastic; not batter-like; not excessively tough', 'Too much kneading can make the seitan rubbery.; Too much liquid can make the dough sticky and hard to shape.', 'If the dough is too sticky, add vital wheat gluten 1 tbsp at a time until manageable.', NULL, '2026-05-02 01:47:29.903790', '2026-05-02 01:47:29.903790') RETURNING "id" /*application='RecipeManager'*/[0m
  ↳ app/services/nested_recipe_importer.rb:67:in 'block in NestedRecipeImporter#create_steps'
  [1m[36mStep Create (0.1ms)[0m  [1m[32mINSERT INTO "steps" ("recipe_id", "order", "title", "action", "time_amount", "time_unit", "time_per_side", "time_description", "temperature_amount", "temperature_unit", "temperature_description", "heat_level", "targets", "risk_points", "notes", "optional_data", "created_at", "updated_at") VALUES (9, 4, 'Shape the seitan', 'Shape the dough into a compact slab or several thick pieces suitable for steaming.', NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, 'even thickness; compact shape; no loose wet patches', '', '', NULL, '2026-05-02 01:47:29.906050', '2026-05-02 01:47:29.906050') RETURNING "id" /*application='RecipeManager'*/[0m
  ↳ app/services/nested_recipe_importer.rb:67:in 'block in NestedRecipeImporter#create_steps'
  [1m[36mStep Create (0.1ms)[0m  [1m[32mINSERT INTO "steps" ("recipe_id", "order", "title", "action", "time_amount", "time_unit", "time_per_side", "time_description", "temperature_amount", "temperature_unit", "temperature_description", "heat_level", "targets", "risk_points", "notes", "optional_data", "created_at", "updated_at") VALUES (9, 5, 'Steam the seitan', 'Steam the shaped seitan until firm and cooked through.', '25', 'min', NULL, NULL, NULL, NULL, 'active steam', NULL, 'firm texture; springy but not wet; sliceable pieces', 'Under-steamed seitan can remain gummy inside.', '', NULL, '2026-05-02 01:47:29.908318', '2026-05-02 01:47:29.908318') RETURNING "id" /*application='RecipeManager'*/[0m
  ↳ app/services/nested_recipe_importer.rb:67:in 'block in NestedRecipeImporter#create_steps'
  [1m[36mStep Create (0.1ms)[0m  [1m[32mINSERT INTO "steps" ("recipe_id", "order", "title", "action", "time_amount", "time_unit", "time_per_side", "time_description", "temperature_amount", "temperature_unit", "temperature_description", "heat_level", "targets", "risk_points", "notes", "optional_data", "created_at", "updated_at") VALUES (9, 6, 'Rest and cut', 'Let the steamed seitan rest briefly, then cut or tear it into bite-size pieces.', '5', 'min', NULL, NULL, NULL, NULL, NULL, NULL, 'pieces hold their shape; rough edges available for browning', '', 'Torn edges brown better than perfectly smooth cuts.', NULL, '2026-05-02 01:47:29.910562', '2026-05-02 01:47:29.910562') RETURNING "id" /*application='RecipeManager'*/[0m
  ↳ app/services/nested_recipe_importer.rb:67:in 'block in NestedRecipeImporter#create_steps'
  [1m[36mStep Create (0.1ms)[0m  [1m[32mINSERT INTO "steps" ("recipe_id", "order", "title", "action", "time_amount", "time_unit", "time_per_side", "time_description", "temperature_amount", "temperature_unit", "temperature_description", "heat_level", "targets", "risk_points", "notes", "optional_data", "created_at", "updated_at") VALUES (9, 7, 'Mix the teriyaki sauce', 'Combine soy sauce, water, sugar, vinegar, ginger, and garlic. If using cornstarch, mix it separately with 1 tbsp water to form a slurry.', NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, 'sugar dissolved; balanced salty-sweet-acidic sauce; no cornstarch lumps', '', 'Keep the cornstarch slurry separate until the sauce is hot.', NULL, '2026-05-02 01:47:29.912790', '2026-05-02 01:47:29.912790') RETURNING "id" /*application='RecipeManager'*/[0m
  ↳ app/services/nested_recipe_importer.rb:67:in 'block in NestedRecipeImporter#create_steps'
  [1m[36mStep Create (0.1ms)[0m  [1m[32mINSERT INTO "steps" ("recipe_id", "order", "title", "action", "time_amount", "time_unit", "time_per_side", "time_description", "temperature_amount", "temperature_unit", "temperature_description", "heat_level", "targets", "risk_points", "notes", "optional_data", "created_at", "updated_at") VALUES (9, 8, 'Sear the seitan', 'Heat neutral oil in a skillet over medium-high heat. Add seitan pieces and brown on multiple sides.', '6', 'min', NULL, NULL, NULL, NULL, NULL, 'medium-high', 'browned edges; light crust; savory toasted aroma', 'Crowding the pan causes steaming instead of browning.; Adding sauce too early prevents crust formation.', '', NULL, '2026-05-02 01:47:29.915084', '2026-05-02 01:47:29.915084') RETURNING "id" /*application='RecipeManager'*/[0m
  ↳ app/services/nested_recipe_importer.rb:67:in 'block in NestedRecipeImporter#create_steps'
  [1m[36mStep Create (0.1ms)[0m  [1m[32mINSERT INTO "steps" ("recipe_id", "order", "title", "action", "time_amount", "time_unit", "time_per_side", "time_description", "temperature_amount", "temperature_unit", "temperature_description", "heat_level", "targets", "risk_points", "notes", "optional_data", "created_at", "updated_at") VALUES (9, 9, 'Glaze with sauce', 'Lower heat to medium, add the teriyaki sauce, and toss the seitan until coated. Add cornstarch slurry if using, then simmer briefly until glossy.', '2', 'min', NULL, NULL, NULL, NULL, NULL, 'medium', 'glossy sauce; seitan evenly coated; sauce clings without becoming gluey', 'Reducing too long can make the sauce overly salty.; Too much cornstarch can make the glaze pasty.', '', NULL, '2026-05-02 01:47:29.917328', '2026-05-02 01:47:29.917328') RETURNING "id" /*application='RecipeManager'*/[0m
  ↳ app/services/nested_recipe_importer.rb:67:in 'block in NestedRecipeImporter#create_steps'
