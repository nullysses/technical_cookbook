<div id="<%= dom_id recipe %>">
  <div>
    <strong>Title:</strong>
    <%= recipe.title %>
  </div>

  <div>
    <strong>Version:</strong>
    <%= recipe.version %>
  </div>

  <div>
    <strong>Language:</strong>
    <%= recipe.language %>
  </div>

  <div>
    <strong>Diet:</strong>
    <%= recipe.diet %>
  </div>

  <div>
    <strong>Tags:</strong>
    <%= recipe.tags %>
  </div>

  <div>
    <strong>Equipment:</strong>
    <%= recipe.equipment %>
  </div>

  <div>
    <strong>Nutrition notes:</strong>
    <%= recipe.nutrition_notes %>
  </div>

  <div>
    <strong>Servings count:</strong>
    <%= recipe.servings_count %>
  </div>

  <div>
    <strong>Servings unit:</strong>
    <%= recipe.servings_unit %>
  </div>

  <div>
    <strong>Yield amount:</strong>
    <%= recipe.yield_amount %>
  </div>

  <div>
    <strong>Yield unit:</strong>
    <%= recipe.yield_unit %>
  </div>

  <div>
    <strong>Yield description:</strong>
    <%= recipe.yield_description %>
  </div>

  <div>
    <strong>Source created from:</strong>
    <%= recipe.source_created_from %>
  </div>

  <div>
    <strong>Source notes:</strong>
    <%= recipe.source_notes %>
  </div>

</div>
