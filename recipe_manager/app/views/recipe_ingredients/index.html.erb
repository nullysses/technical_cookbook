<p style="color: green"><%= notice %></p>

<% content_for :title, "Recipe ingredients" %>

<h1>Recipe ingredients</h1>

<div class="page-actions">
  <%= link_to "New recipe ingredient", new_recipe_ingredient_path, class: "button primary" %>
</div>

<div id="recipe_ingredients">
  <% @recipe_ingredients.each do |recipe_ingredient| %>
    <%= render recipe_ingredient %>
    <p>
      <%= link_to "Show this recipe ingredient", recipe_ingredient %>
    </p>
  <% end %>
</div>
