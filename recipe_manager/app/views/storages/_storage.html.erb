<div id="<%= dom_id storage %>">
  <div>
    <strong>Recipe:</strong>
    <%= storage.recipe_id %>
  </div>

  <div>
    <strong>Refrigerator duration:</strong>
    <%= storage.refrigerator_duration %>
  </div>

  <div>
    <strong>Refrigerator unit:</strong>
    <%= storage.refrigerator_unit %>
  </div>

  <div>
    <strong>Freezer duration:</strong>
    <%= storage.freezer_duration %>
  </div>

  <div>
    <strong>Freezer unit:</strong>
    <%= storage.freezer_unit %>
  </div>

  <div>
    <strong>Reheat:</strong>
    <%= storage.reheat %>
  </div>

</div>
