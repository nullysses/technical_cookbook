  [1m[36mTechniqueNote Create (0.1ms)[0m  [1m[32mINSERT INTO "technique_notes" ("recipe_id", "topic", "note", "created_at", "updated_at") VALUES (4, 'sauce balance', 'If the sauce is too salty, vinegar and sugar can rebalance perception, but dilution is the cleanest correction when salt is excessive.', '2026-05-02 00:37:50.250454', '2026-05-02 00:37:50.250454') RETURNING "id" /*action='create',application='RecipeManager',controller='recipe_imports'*/[0m
