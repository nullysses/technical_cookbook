  [1m[36mTechniqueNote Create (0.1ms)[0m  [1m[32mINSERT INTO "technique_notes" ("recipe_id", "topic", "note", "created_at", "updated_at") VALUES (9, 'seitan texture', 'Vital wheat gluten hydrates quickly and becomes elastic. Knead only enough to form structure; excessive kneading pushes the texture toward rubbery.', '2026-05-02 01:47:30.009189', '2026-05-02 01:47:30.009189') RETURNING "id" /*application='RecipeManager'*/[0m
  ↳ app/services/nested_recipe_importer.rb:89:in 'block in NestedRecipeImporter#create_technique_notes'
  [1m[36mTechniqueNote Create (0.1ms)[0m  [1m[32mINSERT INTO "technique_notes" ("recipe_id", "topic", "note", "created_at", "updated_at") VALUES (9, 'steam before sear', 'Steaming sets the gluten network before browning. Searing raw seitan dough directly can leave the interior gummy.', '2026-05-02 01:47:30.011111', '2026-05-02 01:47:30.011111') RETURNING "id" /*application='RecipeManager'*/[0m
  ↳ app/services/nested_recipe_importer.rb:89:in 'block in NestedRecipeImporter#create_technique_notes'
  [1m[36mTechniqueNote Create (0.1ms)[0m  [1m[32mINSERT INTO "technique_notes" ("recipe_id", "topic", "note", "created_at", "updated_at") VALUES (9, 'browning', 'The seitan should be relatively dry on the surface before searing. Browning creates the savory base that keeps the final dish from tasting like plain gluten in sauce.', '2026-05-02 01:47:30.013346', '2026-05-02 01:47:30.013346') RETURNING "id" /*application='RecipeManager'*/[0m
  ↳ app/services/nested_recipe_importer.rb:89:in 'block in NestedRecipeImporter#create_technique_notes'
