<section id="recipe_ingredients_section" class="detail-section" data-controller="delete-modal">
  <div class="section-heading">
    <h2>Ingredients</h2>
    <%= link_to "Add recipe ingredient", new_recipe_ingredient_path, class: "button" %>
  </div>
  <table class="ingredient-progress-table">
    <thead>
      <tr>
        <th>Section</th>
        <th>Ingredient</th>
        <th>Amount</th>
        <th>Procured</th>
        <th><span class="visually-hidden">Delete</span></th>
      </tr>
    </thead>
    <tbody>
      <% @recipe_ingredients.each do |recipe_ingredient| %>
        <% procured = @procured_recipe_ingredient_ids.include?(recipe_ingredient.id) %>
        <tr>
          <td>
            <%= recipe_ingredient.section.presence || "Not set" %>
          </td>
          <td class="<%= "is-done" if procured %>">
            <%= link_to recipe_ingredient.ingredient.name, recipe_ingredient %>
            <%= "(#{recipe_ingredient.preparation})" if recipe_ingredient.preparation.present? %>
          </td>
          <td>
            <%= [recipe_ingredient.amount, recipe_ingredient.unit].compact_blank.join(" ").presence || "Not set" %>
          </td>
          <td class="procured-cell">
            <%= form_with url: recipe_ingredient_progress_path(recipe_ingredient), method: :patch, class: "progress-form" do |form| %>
              <%= form.check_box :done, checked: procured, onchange: "this.form.requestSubmit()", aria: { label: "Mark #{recipe_ingredient.ingredient.name} procured" } %>
            <% end %>
          </td>
          <td class="delete-cell">
            <%= button_to recipe_ingredient_path(recipe_ingredient), method: :delete, class: "icon-button trash-button", form: { data: { action: "submit->delete-modal#confirm", delete_modal_item_param: recipe_ingredient.ingredient.name } }, aria: { label: "Remove #{recipe_ingredient.ingredient.name} from this recipe" } do %>
              &#128465;
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <dialog class="app-modal" data-delete-modal-target="dialog">
    <div class="app-modal-header">
      <h2>Remove Ingredient</h2>
    </div>
    <p data-delete-modal-target="message">Remove this ingredient from this recipe?</p>
    <div class="app-modal-actions">
      <button type="button" class="button" data-action="delete-modal#cancel">Cancel</button>
      <button type="button" class="button danger" data-action="delete-modal#delete">Remove</button>
    </div>
  </dialog>
</section>
